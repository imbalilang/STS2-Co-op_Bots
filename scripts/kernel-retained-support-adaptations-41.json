    "source": "Unchanged production input captured before latest-run repair; preserve registered existing host support.",
    "changes": [
      {
        "start": 618,
        "end": 618,
        "old": "",
        "new": "    /// <summary>\n    /// Names the pending turn-start choice for diagnostics (uses the same fields as the\n    /// exception message above). Needed because a SteamEruption phase transition leaves one\n    /// behind and the death settlement then fails closed — see CorePowerSupport's\n    /// `TryTriggerSteamEruptionDeath` call site — so a line that KILLS the boss becomes a\n    /// boundary and the search can never see a line that resolves the fight.\n    /// </summary>\n    public string PendingTurnStartChoiceDescription\n        => PendingTurnStartChoice is { } pending ? Describe(pending) : \"none\";\n\n"
      }
    ]
  },
