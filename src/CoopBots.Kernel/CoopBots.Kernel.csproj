<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework><LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>CoopBots.Kernel</AssemblyName><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RestorePackagesPath>$(MSBuildThisFileDirectory).nuget/packages</RestorePackagesPath>
  </PropertyGroup>
  <Import Project="KernelDependencies.props" />
  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="all" />
    <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
    <Reference Include="sts2" HintPath="$(STS2DataDir)/sts2.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(STS2DataDir)/0Harmony.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(STS2DataDir)/GodotSharp.dll" Private="false" />
    <!-- RitsuLib 0.6.x: STS2-RitsuLib forwards to Runtime, which holds the types
         the vendored simulation actually calls, so it has to be referenced too. -->
    <Reference Include="STS2-RitsuLib" HintPath="$(RitsuLibDir)/STS2-RitsuLib.dll" Private="false" />
    <Reference Include="STS2-RitsuLib.Runtime" HintPath="$(RitsuLibDir)/STS2-RitsuLib.Runtime.dll" Private="false" />
    <Reference Include="STS2-RitsuLib.Shared" HintPath="$(RitsuLibSharedDir)/STS2-RitsuLib.Shared.dll" Private="false" />
    <Compile Include="Vendor/**/*.cs" /><Compile Include="*.cs" />

    <None Include="../../THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Upstream mod entry point: this kernel is a host facade, not the CombatSolver
         mod, so its initializer, log directory and enable switch stay out. This is the
         same exclusion the original importer applied at import time. -->
    <Compile Remove="Vendor/Runtime/Entry.cs" />
    <!-- Upstream MOD RUNTIME, not search: bug-report export, the solver controller, the
         instant-mode patch and the turn-setup Harmony hooks all belong to the shipped
         CombatSolver mod. The original importer left them out at import time; this kernel
         vendors the search, so they are excluded at compile time instead. -->
    <Compile Remove="Vendor/Runtime/CombatBugReportExporter.cs" />
    <Compile Remove="Vendor/Runtime/SolverController.cs" />
    <Compile Remove="Vendor/Runtime/CombatInstantModePatch.cs" />
    <Compile Remove="Vendor/Runtime/PlayerTurnSetupPatches.cs" />
    <Compile Remove="Vendor/Runtime/SolverControllerSessions.cs" />
    <Compile Remove="Vendor/Runtime/CombatShowcaseCollector.cs" />
    <Compile Remove="Vendor/Runtime/CombatBugReportMetadata.cs" />
    <Compile Remove="Vendor/UI/**/*.cs" />
    <Compile Remove="Vendor/Testing/**/*.cs" />
    <Compile Remove="Vendor/Api/**/*.cs" />
    <Compile Remove="Vendor/Runtime/CombatShowcaseRuntime.cs" />
    <Compile Remove="Vendor/Runtime/SolverController.Testing.cs" />
    <Compile Remove="Vendor/Runtime/RunStatistics.cs" />
    <Compile Remove="Vendor/Runtime/PerformanceRecording.cs" />
    <Compile Remove="Vendor/Runtime/OnlinePresence.cs" />
    <Compile Remove="Vendor/Runtime/SearchGcPolicy.cs" />
    <Compile Remove="Vendor/Runtime/NativeChoiceRuntime.cs" />
    <Compile Remove="Vendor/Runtime/SolverDispatcher.cs" />
    <Compile Remove="Vendor/Runtime/CombatReplayRecording.cs" />
    <Compile Remove="Vendor/Runtime/CombatBugReportUploader.cs" />
    <Compile Remove="Vendor/Runtime/CombatReplayOutcome.cs" />
    <Compile Remove="Vendor/Runtime/SearchGcPolicy.Recovery.cs" />
    <Compile Remove="Vendor/Runtime/CombatSolverLog.cs" />
    <Compile Remove="Vendor/Diagnostics/PerformanceRecording.cs" />
    <Compile Remove="Vendor/Runtime/SystemMemoryReleaseService.cs" />
    <Compile Remove="Vendor/Diagnostics/PerformanceLifecycle.cs" />
    <!-- The rest of that layer: the overlay UI and the progress/diagnostic mirrors it
         renders from. Same reasoning as the runtime exclusions above. -->
  </ItemGroup>
</Project>
