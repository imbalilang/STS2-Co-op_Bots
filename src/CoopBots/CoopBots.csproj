<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CoopBots</AssemblyName>
    <RootNamespace>CoopBots</RootNamespace>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <STS2DataDir Condition="'$(STS2DataDir)' == ''">/Users/xiwa/Library/Application Support/Steam/steamapps/common/Slay the Spire 2/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_arm64</STS2DataDir>
    <STS2ReferenceVersion Condition="'$(STS2ReferenceVersion)' == ''"></STS2ReferenceVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../CoopBots.Kernel/CoopBots.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      CombatSolver 0.41.0, shipped as its OWN assembly rather than source vendored into
      the kernel. Its RootNamespace is `CombatSolver`, so its type identities do not
      collide with the vendored 0.33.9 engine under `CoopBots.Kernel.Vendor` — both load
      side by side, and only game types cross the boundary.

      COPIED, not ProjectReference'd. A reference would make every consumer of this
      project transitively rebuild CombatSolver, which needs SteamRoot/RitsuLib paths;
      PatchSmoke and the release script do not pass them, and a third-party project should
      not be recompiled on each of our builds anyway. Build it separately with:
        dotnet build work/combatsolver-sync-latest/CombatSolver.csproj -c Release \
          -p:SteamRoot=B:/SteamLibrary -p:Sts2DataDir=<game data dir>
      Conditional so a checkout without the built copy still builds.
    -->
    <None Include="../../work/combatsolver-sync-latest/.godot/mono/temp/bin/Release/CombatSolver.dll"
          Condition="Exists('../../work/combatsolver-sync-latest/.godot/mono/temp/bin/Release/CombatSolver.dll')">
      <Link>CombatSolver.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PatchSmoke</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup Condition="'$(STS2ReferenceVersion)' == ''">
    <Reference Include="sts2">
      <HintPath>$(STS2DataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(STS2DataDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(STS2DataDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(STS2ReferenceVersion)' != ''">
    <PackageReference Include="BSchneppe.Sts2.ReferenceAssemblies" Version="$(STS2ReferenceVersion)" PrivateAssets="All" />
  </ItemGroup>
</Project>
